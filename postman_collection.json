          "name": "Admin Approve Adoption Application",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/adoptions/requests/1/status", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "adoptions", "requests", "1", "status"] }
          }
        }
      ]
    },
