          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportId\": 2,\n  \"name\": \"Luna\",\n  \"species\": \"Cat\",\n  \"breed\": \"Calico\",\n  \"age\": \"1 year\",\n  \"gender\": \"Female\",\n  \"healthNotes\": \"Vaccinated and spayed\",\n  \"description\": \"Sweet kitten recovered from injury.\",\n  \"photoUrl\": \"https://images.unsplash.com/photo-1514888286974-6c03e2ca1dba?w=800&q=80\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/adoptions", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "adoptions"] }
          }
        },
        {
          "name": "Citizen Submit Adoption Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"We would love to give Luna a quiet, caring home with our family!\",\n  \"phone\": \"+91-9876500001\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/adoptions/1/request", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "adoptions", "1", "request"] }
          }
        },
